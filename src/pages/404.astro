---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const contact = await getEntry("contact", "contact");
if (!contact) throw new Error("Contact content missing: src/content/contact/contact.md");
const { email, github } = contact.data;
---

<BaseLayout title="Page not found" description="This page doesn't exist — head back home or reach out directly.">
  <section class="section notfound">
    <div class="container hero-inner">
      <span class="hero-badge"><span class="hero-badge-dot" aria-hidden="true"></span>Error 404</span>
      <h1 class="display-lg">Page not found.</h1>
      <p class="body-lg">The page you're looking for doesn't exist or has moved.</p>
      <div class="hero-ctas">
        <a class="btn btn--primary" href="/">Back home</a>
        <a class="btn btn--secondary" href={`mailto:${email}`}>Email me</a>
        <a class="gh-link" href={github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* micro-hooks, token-based only */
  .notfound { background: var(--soft); }   /* flat canvas band — NO .mesh div (D-09) */
  .notfound .hero-inner { text-align: center; }
  .notfound .body-lg { max-width: 480px; margin-inline: auto; }
  .gh-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 14px;
    font-weight: 500;
    color: var(--link-deep);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-full);
    box-shadow: 0 0 0 1px var(--hairline);
  }
</style>
